---
import Family from '../../../components/Family.astro';
import { OTHER_LOCALES, type Locale } from '../../../i18n';
import { PAIRS, familyExists, type PairKey } from '../../../family/content';

export function getStaticPaths() {
  return OTHER_LOCALES.flatMap((lang) =>
    PAIRS.filter((k) => familyExists(k, lang)).map((pair) => ({ params: { lang, pair } })),
  );
}
const lang = Astro.params.lang as Locale;
const pair = Astro.params.pair as PairKey;
---
<Family lang={lang} pair={pair} />
