---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { DESTS, guidePath, guideExists, GUIDE_UI } from '../guides';
import { FAMILY_UI, PAIRS, familyExists, familyPath } from '../family/content';
import {
  STRINGS, LOCALES, NATIVE_NAME, HREFLANG, homePath, playUrl, price, PRICES,
  CONTACT_EMAIL, PACKAGE_ID, type Locale,
} from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = STRINGS[lang];
const store = playUrl(lang);
const p = (v: number) => price(lang, v);
const site = Astro.site!;
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)])) as Record<Locale, string>;
const g = GUIDE_UI[lang];
const dests = DESTS.filter((d) => guideExists(d, lang));
const fui = FAMILY_UI[lang];
const pairs = PAIRS.filter((k) => familyExists(k, lang));

const asian: Locale[] = ['zh', 'ja', 'ko'];
const european: Locale[] = ['en', 'fr', 'de', 'es', 'it', 'nl', 'pl', 'pt'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Sideby',
    description: t.metaDesc,
    operatingSystem: 'Android',
    applicationCategory: 'TravelApplication',
    inLanguage: LOCALES.map((l) => HREFLANG[l]),
    url: new URL(homePath(lang), site).href,
    downloadUrl: `https://play.google.com/store/apps/details?id=${PACKAGE_ID}`,
    installUrl: `https://play.google.com/store/apps/details?id=${PACKAGE_ID}`,
    image: new URL('/og.png', site).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@type': 'Organization', name: 'Galerne Studio', email: CONTACT_EMAIL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base lang={lang} path={homePath(lang)} alternates={alternates} title={t.metaTitle} description={t.metaDesc} jsonLd={jsonLd}>
  <Header lang={lang} alternates={alternates} />

  <main id="main">
    <section class="hero wrap">
      <div class="hero-text">
        <h1>{t.heroTitle}</h1>
        <p class="lede">{t.heroText}</p>
        <a class="cta" href={store} rel="noopener">
          <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path fill="currentColor" d="M1 1.2v19.6c0 .7.8 1.1 1.4.7l16.2-9.8c.6-.3.6-1.1 0-1.4L2.4.5C1.8.1 1 .5 1 1.2Z"/></svg>
          {t.cta}
        </a>
        <p class="note">{t.ctaNote}</p>
      </div>

      <figure class="phone" aria-label={t.demoLabel}>
        <div class="screen">
          <div class="bar" aria-hidden="true">
            <span class="pair">{lang.toUpperCase()} ⇄ {t.demo.theirsLang.toUpperCase()}</span>
            <span class="plane">
              <svg width="13" height="13" viewBox="0 0 24 24"><path fill="currentColor" d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z"/></svg>
              {t.offlineBadge}
            </span>
          </div>
          <div class="chat">
            <div class="msg me">
              <small lang={HREFLANG[lang]}>{t.demo.mine}</small>
              <span lang={HREFLANG[t.demo.theirsLang]}>{t.demo.theirs}</span>
            </div>
            <div class="msg them">
              <small lang={HREFLANG[t.demo.theirsLang]}>{t.demo.replyTheirs}</small>
              <span lang={HREFLANG[lang]}>{t.demo.replyMine}</span>
            </div>
          </div>
          <div class="mics" aria-hidden="true">
            <div><span class="mic"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"/></svg></span><b lang={HREFLANG[lang]}>{NATIVE_NAME[lang]}</b></div>
            <div><span class="mic"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"/></svg></span><b lang={HREFLANG[t.demo.theirsLang]}>{NATIVE_NAME[t.demo.theirsLang]}</b></div>
          </div>
        </div>
      </figure>
    </section>

    <section class="steps wrap" aria-labelledby="steps-h">
      <h2 id="steps-h">{t.stepsTitle}</h2>
      <ol>
        {t.steps.map((s) => (<li><h3>{s.t}</h3><p>{s.d}</p></li>))}
      </ol>
    </section>

    <section class="features wrap" aria-labelledby="features-h">
      <h2 id="features-h">{t.featuresTitle}</h2>
      <ul>
        {t.features.map((f, i) => (
          <li>
            <h3>{f.t}{i >= 4 && <span class="tag">{t.proTag}</span>}</h3>
            <p>{f.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="languages" aria-labelledby="langs-h">
      <div class="wrap">
        <h2 id="langs-h">{t.langsTitle}</h2>
        <p class="sub">{t.langsText}</p>
        <ul class="asian">
          {asian.map((l) => <li lang={HREFLANG[l]}>{NATIVE_NAME[l]}</li>)}
        </ul>
        <ul class="european">
          {european.map((l) => <li lang={HREFLANG[l]}>{NATIVE_NAME[l]}</li>)}
        </ul>
        <p class="small">{t.uiNote}</p>
      </div>
    </section>

    <section class="guides wrap" aria-labelledby="guides-h">
      <h2 id="guides-h">{g.guidesTitle}</h2>
      <ul>
        {dests.map((d) => (
          <li><a href={guidePath(lang, d)}><strong>{g.destName[d]}</strong><span>{g.guideCard[d]}</span></a></li>
        ))}
      </ul>
    </section>

    {fui && pairs.length > 0 && (
      <section class="guides wrap" aria-labelledby="family-h">
        <h2 id="family-h">{fui.sectionTitle}</h2>
        <ul>
          {pairs.map((k) => (
            <li><a href={familyPath(lang, k)}><strong>{fui.pairLabel[k]}</strong><span>{fui.pairCard[k]}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="pricing wrap" aria-labelledby="pricing-h">
      <h2 id="pricing-h">{t.pricingTitle}</h2>
      <div class="plans">
        <div class="plan trial">
          <h3>{t.trial.t}</h3>
          <p>{t.trial.d}</p>
        </div>
        <div class="plan">
          <h3>{t.standard.t}</h3>
          <p class="amount"><strong>{p(PRICES.stdMonth)}</strong> {t.perMonth}</p>
          <p class="alt">{p(PRICES.stdWeek)} {t.perWeek}</p>
          <ul>{t.standard.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="plan pro">
          <h3>{t.pro.t}</h3>
          <p class="amount"><strong>{p(PRICES.proMonth)}</strong> {t.perMonth}</p>
          <p class="alt">{p(PRICES.proLife)} {t.lifetime}</p>
          <ul>{t.pro.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
      <p class="small">{t.priceNote}</p>
    </section>

    <section class="faq wrap" aria-labelledby="faq-h">
      <h2 id="faq-h">{t.faqTitle}</h2>
      {t.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="closing wrap">
      <a class="cta" href={store} rel="noopener">
        <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path fill="currentColor" d="M1 1.2v19.6c0 .7.8 1.1 1.4.7l16.2-9.8c.6-.3.6-1.1 0-1.4L2.4.5C1.8.1 1 .5 1 1.2Z"/></svg>
        {t.cta}
      </a>
      <p class="note">{t.ctaNote}</p>
    </section>
  </main>

  <Footer lang={lang} alternates={alternates} />
</Base>
