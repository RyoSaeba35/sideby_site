---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { STRINGS, LOCALES, HREFLANG, homePath, playUrl, PACKAGE_ID, type Locale } from '../i18n';
import { GUIDES, GUIDE_UI, DESTS, DEST_LANG, DEST_PHRASES, guidePath, guideExists, type Dest } from '../guides';

interface Props { lang: Locale; dest: Dest }
const { lang, dest } = Astro.props;
const t = STRINGS[lang];
const ui = GUIDE_UI[lang];
const page = GUIDES[dest][lang]!;
const destLang = DEST_LANG[dest];
const store = playUrl(lang);
const site = Astro.site!;
const path = guidePath(lang, dest);
const alternates = Object.fromEntries(
  LOCALES.filter((l) => guideExists(dest, l)).map((l) => [l, guidePath(l, dest)]),
) as Partial<Record<Locale, string>>;
const others = DESTS.filter((d) => d !== dest && guideExists(d, lang));
const step = (s: string) => s.replaceAll('{lang}', ui.langName[destLang]);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sideby', item: new URL(homePath(lang), site).href },
      { '@type': 'ListItem', position: 2, name: ui.destName[dest], item: new URL(path, site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: ui.setupTitle,
    step: ui.setupSteps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: step(s) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base lang={lang} path={path} alternates={alternates} title={page.metaTitle} description={page.metaDesc} jsonLd={jsonLd}>
  <Header lang={lang} alternates={alternates} />
  <main id="main" class="guide">
    <article class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath(lang)}>Sideby</a> <span aria-hidden="true">/</span> <span>{ui.destName[dest]}</span>
      </nav>
      <h1>{page.h1}</h1>
      <p class="lede">{page.intro}</p>
      <a class="cta" href={store} rel="noopener">
        <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path fill="currentColor" d="M1 1.2v19.6c0 .7.8 1.1 1.4.7l16.2-9.8c.6-.3.6-1.1 0-1.4L2.4.5C1.8.1 1 .5 1 1.2Z"/></svg>
        {t.cta}
      </a>
      <p class="note">{t.ctaNote}</p>

      <section aria-labelledby="why-h">
        <h2 id="why-h">{page.whyTitle}</h2>
        <ul class="why">{page.why.map((w) => <li>{w}</li>)}</ul>
      </section>

      {page.note && (
        <aside class="callout">
          <h2>{page.note.t}</h2>
          <p>{page.note.d}</p>
        </aside>
      )}

      <section aria-labelledby="phr-h">
        <h2 id="phr-h">{ui.phrasesTitle}</h2>
        <dl class="phrases">
          {DEST_PHRASES[dest].map((ph, i) => (
            <div>
              <dt lang={HREFLANG[destLang]}>{ph.native}</dt>
              <dd><span class="roman">{ph.roman}</span><span>{ui.phrases[i]}</span></dd>
            </div>
          ))}
        </dl>
        <p class="small">{ui.phrasesNote}</p>
      </section>

      <section aria-labelledby="setup-h">
        <h2 id="setup-h">{ui.setupTitle}</h2>
        <ol class="setup">{ui.setupSteps.map((s) => <li>{step(s)}</li>)}</ol>
      </section>

      <section class="faq" aria-labelledby="gfaq-h">
        <h2 id="gfaq-h">{ui.faqTitle}</h2>
        {page.faq.map((f) => (
          <details open>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="closing">
        <a class="cta" href={store} rel="noopener">
          <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path fill="currentColor" d="M1 1.2v19.6c0 .7.8 1.1 1.4.7l16.2-9.8c.6-.3.6-1.1 0-1.4L2.4.5C1.8.1 1 .5 1 1.2Z"/></svg>
          {t.cta}
        </a>
        <p class="note">{t.ctaNote}</p>
      </section>

      {others.length > 0 && (
        <section aria-labelledby="others-h">
          <h2 id="others-h">{ui.othersTitle}</h2>
          <ul class="guide-links">
            {others.map((d) => <li><a href={guidePath(lang, d)}><strong>{ui.destName[d]}</strong><span>{ui.guideCard[d]}</span></a></li>)}
          </ul>
        </section>
      )}
    </article>
  </main>
  <Footer lang={lang} alternates={alternates} />
</Base>
