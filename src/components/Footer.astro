---
import { STRINGS, LOCALES, NATIVE_NAME, HREFLANG, homePath, CONTACT_EMAIL, privacyPath, type Locale } from '../i18n';
import { DESTS, guidePath, guideExists, GUIDE_UI } from '../guides';
import { FAMILY_UI, PAIRS, familyExists, familyPath } from '../family/content';

interface Props { lang: Locale; alternates: Partial<Record<Locale, string>> }
const { lang, alternates } = Astro.props;
const t = STRINGS[lang];
const g = GUIDE_UI[lang];
const dests = DESTS.filter((d) => guideExists(d, lang));
const fui = FAMILY_UI[lang];
const pairs = PAIRS.filter((k) => familyExists(k, lang));
---
<footer class="foot wrap">
  <nav aria-label={g.guidesTitle}>
    {dests.map((d) => <a href={guidePath(lang, d)}>{g.destName[d]}</a>)}
  </nav>
  {fui && pairs.length > 0 && (
    <nav aria-label={fui.sectionTitle}>
      {pairs.map((k) => <a href={familyPath(lang, k)}>{fui.pairLabel[k]}</a>)}
    </nav>
  )}
  <nav>
    <a href={privacyPath(lang)}>{t.privacy}</a>
    <a href={`mailto:${CONTACT_EMAIL}`}>{t.contact}</a>
  </nav>
  <nav class="foot-langs" aria-label={t.langLabel}>
    {LOCALES.map((l) => (
      <a href={alternates[l] ?? homePath(l)} hreflang={HREFLANG[l]} lang={HREFLANG[l]} aria-current={l === lang ? 'page' : undefined}>{NATIVE_NAME[l]}</a>
    ))}
  </nav>
  <p>{t.madeBy}</p>
</footer>
